#include <LiquidCrystal.h>
#include <Servo.h>

// LCD Setup (RS=12, E=6, D4=5, D5=4, D6=3, D7=2)
LiquidCrystal lcd(12, 6, 5, 4, 3, 2);

// Servo and Joystick definitions
Servo myServo;
const int joystickPin = A0;
const int servoPin = 9;

void setup() {
  lcd.begin(16, 2);
  myServo.attach(servoPin);
  
  lcd.print("Joystick Servo");
  delay(1000);
  lcd.clear();
}

void loop() {
  // 1. Read the joystick X-axis value (0 to 1023)
  int joystickValue = analogRead(joystickPin);
  
  // 2. Map the value to servo degrees (0 to 180)
  int servoAngle = map(joystickValue, 0, 1023, 0, 180);
  
  // 3. Move the servo motor to the target angle
  myServo.write(servoAngle);
  
  // 4. Display the live angle on the LCD screen
  lcd.setCursor(0, 0);
  lcd.print("Joystick Ctrl   ");
  
  lcd.setCursor(0, 1);
  lcd.print("Angle: ");
  lcd.print(servoAngle);
  lcd.print(" deg   "); // Extra spaces to clear old trailing digits

  delay(50); // Small delay for smooth operation
}
