#include <Servo.h>
#include <LiquidCrystal.h>

// LCD Setup (RS=12, E=6, D4=5, D5=4, D6=3, D7=2)
LiquidCrystal lcd(12, 6, 5, 4, 3, 2);
Servo myServo;

// Pin Definitions (Buzzer is on Pin 13)
const int joystickPin = A0;
const int servoPin = 9;
const int buzzerPin = 13; 

// Timing variables for non-blocking buzzer beeps
unsigned long previousMillis = 0;
bool buzzerState = false;

void setup() {
  lcd.begin(16, 2);
  myServo.attach(servoPin);
  pinMode(buzzerPin, OUTPUT);
  
  lcd.print("Proportional");
  lcd.setCursor(0, 1);
  lcd.print("Control Online");
  delay(1500);
  lcd.clear();
}

void loop() {
  // 1. Read joystick and map to servo angle (0 to 180 degrees)
  int joyVal = analogRead(joystickPin);
  int angle = map(joyVal, 0, 1023, 0, 180);
  myServo.write(angle);

  // 2. Calculate deviation from center (Center is ~512)
  int deviation = abs(joyVal - 512);

  // 3. Determine buzzer state based on joystick position
  if (deviation < 40) {
    // Relaxed zone (Center) -> Stop beeping completely
    digitalWrite(buzzerPin, LOW);
    buzzerState = false;
  } else {
    // Pushed Left or Right -> Faster beeping the further you push
    int beepInterval = map(deviation, 40, 512, 400, 30);
    beepInterval = constrain(beepInterval, 30, 400);

    // Non-blocking buzzer toggle
    unsigned long currentMillis = millis();
    if (currentMillis - previousMillis >= beepInterval) {
      previousMillis = currentMillis;
      buzzerState = !buzzerState;
      digitalWrite(buzzerPin, buzzerState ? HIGH : LOW);
    }
  }

  // 4. Update LCD Telemetry Dashboard
  lcd.setCursor(0, 0);
  if (deviation < 40) {
    lcd.print("Status: RELAXED ");
  } else if (joyVal < 512) {
    lcd.print("Status: LEFT    ");
  } else {
    lcd.print("Status: RIGHT   ");
  }

  // Display exact degree rotation on line 2
  lcd.setCursor(0, 1);
  lcd.print("Angle: ");
  lcd.print(angle);
  lcd.print(" deg   "); 

  delay(20); 
}
